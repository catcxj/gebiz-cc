DEBUG=false
DATABASE_URL=sqlite:///./gebiz.db

# every 24 hours, Singapore time
SCRAPE_CRON=0 0 * * *
SCRAPE_TIMEZONE=Asia/Singapore

# Set to true to use mock data (no real scraping, no Playwright needed)
USE_MOCK_SCRAPER=false

# SMTP for email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

ADMIN_ALERT_EMAILS=
